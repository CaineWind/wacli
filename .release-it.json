{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false,
    "releaseName": "wacli v${version}"
  },
  "hooks": {
    "before:init": ["npm run build"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to WindCli will be documented in this file.\n",
      "preset": "conventionalcommits"
    }
  }
}
